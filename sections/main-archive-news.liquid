{{ 'section-archive-news.css' | asset_url | stylesheet_tag }}

<section id="archive-news" class="archive-news">
  <div class="archive-news__content">
    <aside class="archive-news__aside">
      <h3 class="capitalize">category</h3>
      <ul class="archive-news__categories">
        {% for tag in blog.all_tags %}
          <li class="archive-news__category-item">
            <a class="capitalize" href="{{ blog.url }}/tagged/{{ tag | handle }}">{{ tag }}</a>
          </li>
        {% endfor %}
      </ul>
    </aside>
    <div class="archive-news__main">
      {% paginate blog.articles by section.settings.articles_per_page %}
        <div class="archive-news__list">
          {% for article in blog.articles %}
            <article class="archive-news__item">
              <a class="archive-news__link" href="{{ article.url }}">
                <div class="archive-news__item-meta">
                  <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
                    {{ article.published_at | date: '%Y.%m.%d' }}
                  </time>
                  {%- if article.tags.size > 0 -%}
                    <span class="archive-news__category-label capitalize">{{ article.tags.first }}</span>
                  {%- endif -%}
                </div>
                <h3>{{ article.title }}</h3>
              </a>
            </article>
          {% endfor %}
        </div>

        {% if paginate.pages > 1 %}
          <nav class="archive-news__pagination" role="navigation" aria-label="Pagination">
            <ul class="archive-news__pagination-list">
              {% if paginate.previous %}
                <li class="archive-news__pagination-item archive-news__pagination-item--prev prev">
                  <a class="capitalize" href="{{ paginate.previous.url }}"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640"><path d="M169.4 297.4C156.9 309.9 156.9 330.2 169.4 342.7L361.4 534.7C373.9 547.2 394.2 547.2 406.7 534.7C419.2 522.2 419.2 501.9 406.7 489.4L237.3 320L406.6 150.6C419.1 138.1 419.1 117.8 406.6 105.3C394.1 92.8 373.8 92.8 361.3 105.3L169.3 297.3z"/></svg>prev</a>
                </li>
              {% endif %}

              {% for part in paginate.parts %}
                <li class="archive-news__pagination-item archive-news__pagination-item--num
                  {% unless part.is_link %}is-current{% endunless %}">
                  {% if part.is_link %}
                    <a href="{{ part.url }}">{{ part.title }}</a>
                  {% else %}
                    <span aria-current="page">{{ part.title }}</span>
                  {% endif %}
                </li>
              {% endfor %}
        
              {% if paginate.next %}
                <li class="archive-news__pagination-item archive-news__pagination-item--next next">
                  <a class="capitalize" href="{{ paginate.next.url }}">next<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640"><path d="M471.1 297.4C483.6 309.9 483.6 330.2 471.1 342.7L279.1 534.7C266.6 547.2 246.3 547.2 233.8 534.7C221.3 522.2 221.3 501.9 233.8 489.4L403.2 320L233.9 150.6C221.4 138.1 221.4 117.8 233.9 105.3C246.4 92.8 266.7 92.8 279.2 105.3L471.2 297.3z"/></svg></a>
                </li>
              {% endif %}
            </ul>
          </nav>
        {% endif %}
      {% endpaginate %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "News list",
  "tag": "section",
  "class": "section-news",
  "settings": [
    {
      "type": "range",
      "id": "articles_per_page",
      "label": "表示件数",
      "min": 3,
      "max": 20,
      "step": 1,
      "default": 7
    }
  ]
}
{% endschema %}