{{ 'section-product-list.css' | asset_url | stylesheet_tag }}

<section id="products-page" class="products-page">
  <div class="products-page__content">
    <aside class="products-page__aside">
      {%- if request.page_type == 'search' -%}
        <form action="{{ routes.search_url }}" method="get" class="products-page__search-form">
          <div class="products-page__search-input">
            <input
              type="search"
              name="q"
              value="{{ search.terms | escape }}"
              placeholder="検索する"
              aria-label="商品検索"
              autocomplete="off"
            >
            <button class="products-page__search-button" type="submit">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 640 640">
              <path d="M480 272C480 317.9 465.1 360.3 440 394.7L566.6 521.4C579.1 533.9 579.1 554.2 566.6 566.7C554.1 579.2 533.8 579.2 521.3 566.7L394.7 440C360.3 465.1 317.9 480 272 480C157.1 480 64 386.9 64 272C64 157.1 157.1 64 272 64C386.9 64 480 157.1 480 272zM272 416C351.5 416 416 351.5 416 272C416 192.5 351.5 128 272 128C192.5 128 128 192.5 128 272C128 351.5 192.5 416 272 416z"/></svg>
            </button>
          </div>
        </form>
      {%- endif -%}
      <div class="products-page__categories">
        <h3 class="capitalize">category</h3>
        <ul class="products-page__category-list">
          {%- for product_category in collections -%}
            {%- if product_category.handle != 'all' -%}
              <li class="products-page__category-item fade-up">
                {%- if request.page_type == 'search' -%}
                  <a class="capitalize" href="{{ routes.search_url }}?q={{ product_category.handle }}&collection={{ product_category.handle }}">
                    {{ product_category.title }}
                  </a>
                {%- else -%}
                  <a class="capitalize" href="{{ product_category.url }}">
                    {{ product_category.title }}
                  </a>
                {%- endif -%}
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>
    </aside>
    <div class="products-page__main">
      {%- if request.page_type == 'search' -%}
        {% render 'product-search', section: section %}
      {%- else -%}
        {% render 'product-collection', section: section %}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Products",
  "tag": "section",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "label": "表示件数",
      "min": 3,
      "max": 30,
      "step": 1,
      "default": 9
    }
  ]
}
{% endschema %}