{{ 'section-single-news.css' | asset_url | stylesheet_tag }}

{% assign articles = blog.articles %}
{% for a in articles %}
  {% if a.id == article.id %}
    {% assign current_index = forloop.index0 %}
  {% endif %}
{% endfor %}
{% assign last_index = articles.size | minus: 1 %}
{% assign prev_index = current_index | minus: 1 %}
{% assign next_index = current_index | plus: 1 %}

<article class="single-news">
  <div class="single-news__content">
    <div class="single-news__meta">
      <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
        {{ article.published_at | date: '%Y.%m.%d' }}
      </time>
      {% if article.tags.size > 0 %}
        <span class="single-news__category capitalize">
          {{ article.tags.first }}
        </span>
      {% endif %}
    </div>
    <h3 class="fade-up">{{ article.title }}</h3>
    {% if article.image %}
      <div class="single-news__image">
        {{ article.image | image_url: width: 480 | image_tag }}
      </div>
    {% endif %}
    <div class="single-news__main rte fade-up">
      {{ article.content }}
    </div>
    <div class="single-news__nav-wrapper">
      <nav class="single-news__nav">
        {% if prev_index >= 0 %}
          <a class="single-news__prev"
             href="{{ articles[prev_index].url }}">
             <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640"><path d="M169.4 297.4C156.9 309.9 156.9 330.2 169.4 342.7L361.4 534.7C373.9 547.2 394.2 547.2 406.7 534.7C419.2 522.2 419.2 501.9 406.7 489.4L237.3 320L406.6 150.6C419.1 138.1 419.1 117.8 406.6 105.3C394.1 92.8 373.8 92.8 361.3 105.3L169.3 297.3z"/></svg>
          </a>
        {% endif %}
  
        <div class="single-news__button">
          {% render 'custom-button',
            btn_url: section.settings.news_button_url,
            btn_label: section.settings.news_button_label
          %}
        </div>
  
        {% if next_index <= last_index %}
          <a class="single-news__next"
             href="{{ articles[next_index].url }}">
             <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640"><path d="M471.1 297.4C483.6 309.9 483.6 330.2 471.1 342.7L279.1 534.7C266.6 547.2 246.3 547.2 233.8 534.7C221.3 522.2 221.3 501.9 233.8 489.4L403.2 320L233.9 150.6C221.4 138.1 221.4 117.8 233.9 105.3C246.4 92.8 266.7 92.8 279.2 105.3L471.2 297.3z"/></svg>
          </a>
        {% endif %}
      </nav>
    </div>
  </div>
</article>

{% schema %}
{
  "name": "Single News",
  "settings": [
    {
      "type": "header",
      "content": "ボタンレイアウト"
    },
    {
      "type": "text",
      "id": "news_button_label",
      "label": "ボタン文言",
      "default": "一覧ページへ戻る"
    },
    {
      "type": "url",
      "id": "news_button_url",
      "label": "リンク先"
    },
  ]
}
{% endschema %}